#!/bin/sh
# Blocks the commit if the tests fail (Gren compilation, Gren unit tests, app.js up to date, data, PWA).
# Enabled by `git config core.hooksPath .githooks` (see `yarn prepare`).
export COREPACK_ENABLE_DOWNLOAD_PROMPT=0

echo "pre-commit: tests…"
corepack yarn --silent test >/dev/null || { corepack yarn --silent test >&2; echo "pre-commit: tests failed, commit aborted." >&2; exit 1; }
