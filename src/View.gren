module View exposing (view)

{-| `view : Model -> Document Msg`. The ids and CSS classes are stable (used by `style.css`).
-}

import Array exposing (Array)
import Browser exposing (Document)
import Catalog.Catalog as Catalog
import Catalog.View as CatalogView
import Html exposing (Html, section)
import Html.Attributes exposing (id)
import Layout.Card as Card
import Layout.Page as Page
import Program.View as ProgramView
import Quiz.View as QuizView
import Root exposing (Model, Msg(..), Screen(..), currentData)
import Video.View as VideoView


view : Model -> Document Msg
view model =
    { title = "Aïkido – Entraînement"
    , body = [ page model (screens model) ]
    }


screens : Model -> Array (Html Msg)
screens model =
    when model.catalog.status is
        Catalog.Loading ->
            [ title, CatalogView.loading ]

        Catalog.Failed message ->
            [ title, CatalogView.failed message ]

        Catalog.Ready ->
            when model.screen is
                Home ->
                    [ title, homeView model ]

                Quiz quiz ->
                    [ Html.map QuizMsg (QuizView.view (context model) quiz) ]

                Program program ->
                    [ Html.map ProgramMsg (ProgramView.view (context model) program) ]


page : Model -> Array (Html Msg) -> Html Msg
page model content =
    Page.page (Html.map VideoMsg (VideoView.modal model.video)) content


title : Html Msg
title =
    Page.title GoHome



-- HOME


homeView : Model -> Html Msg
homeView model =
    section [ id "home" ] [ Html.map CatalogMsg (CatalogView.view model.catalog), QuizView.picker (currentData model) model.catalog.filters StartSession ]


-- CARD


context : Model -> Card.Context
context model =
    { data = currentData model, slide = model.slide, skipVideoWarning = model.video.skipWarning }
