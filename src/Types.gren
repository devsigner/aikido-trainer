module Types exposing
    ( Model
    , Msg(..)
    , Screen(..)
    , currentData
    , routeOf
    )

{-| The model and the messages of the app.
-}

import Browser
import Browser.Navigation as Navigation
import Catalog.Catalog as Catalog
import Program.Program as Program
import Quiz.Quiz as Quiz
import Shared.Grade exposing (GradeData)
import Shared.Route exposing (Route)
import Slide.Slide as Slide
import Url exposing (Url)
import Video.Video as Video


{-| The screen is the state of the session: no session (home), a quiz, or the program.
-}
type Screen
    = Home
    | Quiz Quiz.Model
    | Program Program.Model


type alias Model =
    { key : Navigation.Key
    , catalog : Catalog.Model
    , screen : Screen
    , initialRoute : Route
    , slide : Slide.Model
    , video : Video.Model
    }


type Msg
    = CatalogMsg Catalog.Msg
    | StartSession String
    | QuizMsg Quiz.Msg
    | ProgramMsg Program.Msg
    | GoHome
    | UrlRequested Browser.UrlRequest
    | UrlChanged Url
    | VideoMsg Video.Msg
    | NoOp


{-| Data of the selected grade (empty while nothing is loaded).
-}
currentData : Model -> GradeData
currentData model =
    Catalog.currentData model.catalog


{-| The route that shows the state of the model.
-}
routeOf : Model -> Route
routeOf model =
    let
        base =
            { grade = Just model.catalog.gradeId, waza = Nothing, program = Nothing }
    in
    when model.screen is
        Home ->
            base

        Quiz quiz ->
            { base | waza = Just quiz.waza }

        Program program ->
            { base | waza = Just program.waza, program = Just program.level }
