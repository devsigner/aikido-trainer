module Main exposing (main)

{-| Aikido Trainer: draws random aikido techniques, and browses the program of a grade.
-}

import Array exposing (Array)
import Browser
import Browser.Dom as Dom
import Browser.Navigation as Navigation
import Catalog.Catalog as Catalog
import Dict
import Shared.Grade as Grade exposing (GradeData, GradeInfo)
import Http
import Json.Decode as Decode exposing (Decoder)
import Random
import Shared.Route as Route exposing (ProgramLevel(..), Route)
import Task exposing (Task)
import Slide.Slide as Slide exposing (Direction(..))
import Types exposing (Model, Msg(..), Screen(..), currentData, routeOf)
import Url exposing (Url)
import Video.Video as Video
import View


type alias Flags =
    { skipVideoWarning : Bool }


main : Program Flags Model Msg
main =
    Browser.application
        { init = init
        , view = View.view
        , update = update
        , subscriptions = \_ -> Sub.none
        , onUrlRequest = UrlRequested
        , onUrlChange = UrlChanged
        }


init : Flags -> Url -> Navigation.Key -> { model : Model, command : Cmd Msg }
init flags url key =
    let
        catalog =
            Catalog.init
    in
    { model =
        { key = key
        , catalog = catalog.model
        , screen = Home
        , initialRoute = Route.parse (Maybe.withDefault "" url.fragment)
        , slide = Slide.init
        , video = Video.init flags.skipVideoWarning
        }
    , command = Cmd.map CatalogMsg catalog.command
    }



-- UPDATE


update : Msg -> Model -> { model : Model, command : Cmd Msg }
update msg model =
    when msg is
        CatalogMsg catalogMsg ->
            let
                result =
                    Catalog.update catalogMsg model.catalog
            in
            Array.foldl
                (\event acc ->
                    let
                        handled =
                            whenCatalogEvent event acc.model
                    in
                    { model = handled.model, command = Cmd.batch [ acc.command, handled.command ] }
                )
                { model = { model | catalog = result.model }, command = Cmd.map CatalogMsg result.command }
                result.events

        StartSession waza ->
            let
                started =
                    startSession model waza
            in
            pushUrl
                { model = slide Forward started.model
                , command = Cmd.batch [ started.command, scrollTop ]
                }

        Next ->
            when model.screen is
                Quiz quiz ->
                    if Array.isEmpty quiz.pool then
                        { model = slide Forward { model | screen = Quiz { quiz | current = Nothing, done = True } }
                        , command = scrollTop
                        }

                    else
                        { model = model, command = roll }

                _ ->
                    stay model

        -- Randomness is a command (so `update` stays pure): the answer is the draw.
        Rolled random ->
            when model.screen is
                Quiz quiz ->
                    if Array.isEmpty quiz.pool then
                        stay model

                    else
                        let
                            index =
                                Grade.pickIndex quiz.pool random
                        in
                        { model =
                            slide Forward
                                { model
                                    | screen =
                                        Quiz
                                            { quiz
                                                | current = Array.get index quiz.pool
                                                , pool = Array.remove index quiz.pool
                                            }
                                }
                        , command = scrollTop
                        }

                _ ->
                    stay model

        OpenProgram ->
            when model.screen is
                Quiz quiz ->
                    pushUrl
                        { model = slide Forward { model | screen = Program { waza = quiz.waza, level = Attacks } }
                        , command = scrollTop
                        }

                _ ->
                    stay model

        Navigate target ->
            when model.screen is
                Program program ->
                    let
                        direction =
                            when target.direction is
                                Just given ->
                                    given

                                Nothing ->
                                    if levelDepth target.to < levelDepth program.level then
                                        Back

                                    else
                                        Forward
                    in
                    pushUrl
                        { model = slide direction { model | screen = Program { program | level = target.to } }
                        , command = scrollTop
                        }

                _ ->
                    stay model

        -- Back from the program: a fresh session of the same waza.
        CloseProgram ->
            when model.screen is
                Program program ->
                    let
                        started =
                            startSession model program.waza
                    in
                    pushUrl
                        { model = slide Back started.model
                        , command = Cmd.batch [ started.command, scrollTop ]
                        }

                _ ->
                    stay model

        GoHome ->
            when model.screen is
                Home ->
                    stay model

                Quiz _ ->
                    pushUrl { model = slide Forward { model | screen = Home }, command = scrollTop }

                Program _ ->
                    pushUrl { model = slide Back { model | screen = Home }, command = scrollTop }

        -- The only internal link is the manual: it leaves the app.
        UrlRequested (Browser.Internal url) ->
            { model = model, command = Navigation.load (Url.toString url) }

        UrlRequested (Browser.External url) ->
            { model = model, command = Navigation.load url }

        -- The browser went back or forward (or the URL was edited): the URL is the source of truth.
        UrlChanged url ->
            let
                route =
                    Route.parse (Maybe.withDefault "" url.fragment)
            in
            if model.catalog.status /= Catalog.Ready || route == routeOf model then
                stay model

            else
                let
                    direction =
                        if Route.depth route < Route.depth (routeOf model) then
                            Back

                        else
                            Forward
                in
                applyRoute route direction model
                    |> andReplaceUrl

        VideoMsg videoMsg ->
            let
                result =
                    Video.update videoMsg model.video
            in
            { model = { model | video = result.model }, command = Cmd.map VideoMsg result.command }

        NoOp ->
            stay model


stay : Model -> { model : Model, command : Cmd Msg }
stay model =
    { model = model, command = Cmd.none }


-- EVENTS


whenCatalogEvent : Catalog.Event -> Model -> { model : Model, command : Cmd Msg }
whenCatalogEvent event model =
    when event is
        -- The route of the URL is applied, and written back without a history entry (it may have been narrowed).
        Catalog.GradesReady ->
            let
                route =
                    model.initialRoute

                selected =
                    when route.grade is
                        Just id ->
                            { model | catalog = Catalog.select id model.catalog }

                        Nothing ->
                            model
            in
            applyRoute route Still selected
                |> andReplaceUrl

        Catalog.GradeChanged ->
            replaceUrl model


levelDepth : ProgramLevel -> Int
levelDepth level =
    when level is
        Attacks ->
            1

        Techniques _ ->
            2

        TechniqueCard _ ->
            3


slide : Direction -> Model -> Model
slide direction model =
    { model | slide = Slide.advance direction model.slide }


scrollTop : Cmd Msg
scrollTop =
    Task.perform (\_ -> NoOp) (Dom.setViewport 0 0)


roll : Cmd Msg
roll =
    Random.generate Rolled (Random.float 0 1)



-- SESSION


{-| A new session of `waza`, with the data and the filters of the grade; draws the first technique.
-}
startSession : Model -> String -> { model : Model, command : Cmd Msg }
startSession model waza =
    let
        pool =
            Grade.buildPool (currentData model) waza model.catalog.filters

        quiz =
            { waza = waza, pool = pool, total = Array.length pool, current = Nothing, done = Array.isEmpty pool }
    in
    { model = { model | screen = Quiz quiz }
    , command =
        if Array.isEmpty pool then
            Cmd.none

        else
            roll
    }



-- URL


{-| The route narrowed to what the data contains: an unknown waza gives the home, an unknown attack or technique the level above.
-}
applyRoute : Route -> Direction -> Model -> { model : Model, command : Cmd Msg }
applyRoute route direction model =
    let
        data =
            currentData model

        validWaza =
            route.waza
                |> Maybe.andThen
                    (\waza ->
                        if Array.member waza Grade.wazaOrder then
                            Just waza

                        else
                            Nothing
                    )

        result =
            when validWaza is
                Nothing ->
                    stay { model | screen = Home }

                Just waza ->
                    when route.program is
                        Just wanted ->
                            stay { model | screen = Program { waza = waza, level = validLevel data waza wanted } }

                        Nothing ->
                            when model.screen is
                                Quiz quiz ->
                                    if quiz.waza == waza then
                                        stay model

                                    else
                                        startSession model waza

                                _ ->
                                    startSession model waza

        changed =
            routeOf result.model /= routeOf model
    in
    { model =
        if changed then
            slide direction result.model

        else
            result.model
    , command = result.command
    }


validLevel : GradeData -> String -> ProgramLevel -> ProgramLevel
validLevel data waza wanted =
    let
        attackExists name =
            Array.any (\attack -> attack.name == name) (Grade.listAttacks data waza)

        techniqueExists attack name =
            Array.any (\technique -> technique.name == name) (Grade.listTechniques data waza attack)
    in
    when wanted is
        Attacks ->
            Attacks

        Techniques attack ->
            if attackExists attack then
                Techniques attack

            else
                Attacks

        TechniqueCard card ->
            if not (attackExists card.attack) then
                Attacks

            else if techniqueExists card.attack card.technique then
                TechniqueCard card

            else
                Techniques card.attack


urlOf : Model -> String
urlOf model =
    Route.toHash (routeOf model)


{-| A user action changed what the screen shows: the URL follows, with a history entry.
-}
pushUrl : { model : Model, command : Cmd Msg } -> { model : Model, command : Cmd Msg }
pushUrl result =
    { model = result.model
    , command = Cmd.batch [ result.command, Navigation.pushUrl result.model.key (urlOf result.model) ]
    }


replaceUrl : Model -> { model : Model, command : Cmd Msg }
replaceUrl model =
    { model = model, command = Navigation.replaceUrl model.key (urlOf model) }


andReplaceUrl : { model : Model, command : Cmd Msg } -> { model : Model, command : Cmd Msg }
andReplaceUrl result =
    { model = result.model
    , command = Cmd.batch [ result.command, Navigation.replaceUrl result.model.key (urlOf result.model) ]
    }
