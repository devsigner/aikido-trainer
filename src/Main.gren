module Main exposing (main)

{-| Aikido Trainer: draws random aikido techniques, and browses the program of a grade.
-}

import Browser
import Navigation.Navigation as Navigation
import Root exposing (Flags, Model, Msg(..))
import View


main : Program Flags Model Msg
main =
    Browser.application
        { init = Root.init
        , view = View.view
        , update = Root.update
        , subscriptions = \_ -> Sub.none
        , onUrlRequest = \request -> NavigationMsg (Navigation.UrlRequested request)
        , onUrlChange = \url -> NavigationMsg (Navigation.UrlChanged url)
        }
